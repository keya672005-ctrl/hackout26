{
  "name": "biofix",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BioFix — algae-based carbon sequestration monitoring. HackOut'26, team Pixel Error.",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:api": "node -e \"process.chdir('backend');require('child_process').spawnSync(process.platform==='win32'?'.venv/Scripts/python.exe':'.venv/bin/python',['-m','uvicorn','app:app','--reload','--port','8000'],{stdio:'inherit'})\"",
    "dev:web": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "demo": "node scripts/demo.js",
    "demo:check": "node scripts/demo.js --check",
    "demo:time": "node frontend/demo_runthrough.mjs"
  }
}
