# Normalise line endings. Git checks these out as CRLF on Windows by default,
# and a CRLF Dockerfile or shell script breaks inside a Linux container with an
# error that points nowhere useful. The whole team is on Windows, so pin the
# files the build actually executes.
* text=auto
# Office files are zip containers. `text=auto` detects that today, but say
# it outright -- a single normalised byte corrupts the archive and the failure
# is "PowerPoint can't open it", which points nowhere near line endings.
*.pptx binary
*.docx binary
Dockerfile text eol=lf
*.sh text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
